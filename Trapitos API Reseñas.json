{
    "info": {
        "name": "Trapitos - A\u00f1adir Rese\u00f1a a Producto",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "POST A\u00f1adir Rese\u00f1a",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"producto_id\": 1,\n    \"comentario\": \"Excelente calidad y entrega r\\u00e1pida.\",\n    \"calificacion\": 5\n}"
                },
                "url": {
                    "raw": "https://www.trapitos.com.es/api/resenas",
                    "protocol": "https",
                    "host": [
                        "www",
                        "trapitos",
                        "com",
                        "es"
                    ],
                    "path": [
                        "api",
                        "resenas"
                    ]
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Estado 201 Created\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"La respuesta contiene los datos de la rese\u00f1a\", function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property(\"comentario\");",
                            "    pm.expect(jsonData).to.have.property(\"calificacion\");",
                            "    pm.expect(jsonData.calificacion).to.be.within(1, 5);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        }
    ]
}