{
  "info": {
    "name": "Prueba de rendimiento - B\u00fasquedas m\u00faltiples",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "B\u00fasqueda \u2013 camiseta",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/buscar?q=camiseta",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "buscar"
          ],
          "query": [
            {
              "key": "q",
              "value": "camiseta"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Respuesta exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Tiempo de respuesta menor a 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "let tiempos = pm.environment.get(\"tiempos\") || \"[]\";",
              "try {",
              "    tiempos = JSON.parse(tiempos);",
              "} catch (e) {",
              "    tiempos = [];",
              "}",
              "",
              "tiempos.push({",
              "    query: pm.request.url.query.toString(),",
              "    time: pm.response.responseTime",
              "});",
              "",
              "pm.environment.set(\"tiempos\", JSON.stringify(tiempos));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
