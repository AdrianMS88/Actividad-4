    {
      "name": "Evaluaci\u00f3n de rendimiento",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}",
          "host": [
            "{{base_url}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let tiempos = pm.environment.get(\"tiempos\");",
              "try {",
              "    if (typeof tiempos === \"string\") tiempos = JSON.parse(tiempos);",
              "",
              "    if (!Array.isArray(tiempos) || tiempos.length === 0) {",
              "        console.warn(\"No hay datos de tiempo almacenados.\");",
              "        pm.test(\"No se encontraron datos de tiempo para evaluar\", function () {",
              "            pm.expect.fail(\"No hay datos suficientes para calcular m\u00e9tricas.\");",
              "        });",
              "    } else {",
              "        let promedio = tiempos.reduce((acc, item) => acc + item.time, 0) / tiempos.length;",
              "        let max = Math.max(...tiempos.map(t => t.time));",
              "        let min = Math.min(...tiempos.map(t => t.time));",
              "",
              "        console.log(\"Tiempos registrados:\", tiempos);",
              "        console.log(\"Promedio:\", promedio + \" ms\");",
              "        console.log(\"M\u00e1ximo:\", max + \" ms\");",
              "        console.log(\"M\u00ednimo:\", min + \" ms\");",
              "",
              "        pm.test(\"Promedio de tiempo < 1000 ms\", function () {",
              "            pm.expect(promedio).to.be.below(1000);",
              "        });",
              "    }",
              "} catch (error) {",
              "    console.error(\"Error al procesar tiempos:\", error);",
              "    pm.test(\"Error al analizar datos de tiempos\", function () {",
              "        pm.expect.fail(\"Error JSON o estructura incorrecta.\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
